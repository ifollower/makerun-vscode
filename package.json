{
  "name": "make-run-tasks",
  "displayName": "Make Run Tasks",
  "description": "Run Makefile targets from the editor or task explorer, individually or in sequence.",
  "version": "1.7.10",
  "publisher": "ai-follwer",
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "homepage": "https://github.com/ifollower/makerun-vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ifollower/makerun-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/ifollower/makerun-vscode/issues"
  },
  "engines": {
    "vscode": "^1.134.0",
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.12.0 || ^24.0.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "makefile",
    "make",
    "tasks",
    "task runner",
    "activity bar"
  ],
  "activationEvents": [
    "onLanguage:makefile",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "make-tasks-mcp": "./dist/mcp/index.mjs"
  },
  "files": [
    "dist/**",
    "assets/**",
    "docs/make-tasks-specification.md",
    "docs/publishing.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "makefileTasks.resumeExecution",
        "title": "Resume from Failure",
        "category": "Make Run Tasks",
        "icon": "$(debug-continue)"
      },
      {
        "command": "makefileTasks.rerunExecution",
        "title": "Rerun",
        "category": "Make Run Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "makefileTasks.deleteExecution",
        "title": "Delete Run",
        "category": "Make Run Tasks",
        "icon": "$(trash)"
      },
      {
        "command": "makefileTasks.copyExecutionCommands",
        "title": "Copy Commands",
        "category": "Make Run Tasks",
        "icon": "$(copy)"
      },
      {
        "command": "makefileTasks.showExecutionCommands",
        "title": "Show Commands",
        "category": "Make Run Tasks",
        "icon": "$(terminal)"
      },
      {
        "command": "makefileTasks.openExecutionTarget",
        "title": "Go to Target Definition",
        "category": "Make Run Tasks",
        "icon": "$(go-to-file)"
      },
      {
        "command": "makefileTasks.cancelExecution",
        "title": "Cancel Run",
        "category": "Make Run Tasks",
        "icon": "$(debug-stop)"
      },
      {
        "command": "makefileTasks.clearExecutionHistory",
        "title": "Clear Completed Runs",
        "category": "Make Run Tasks",
        "icon": "$(clear-all)",
        "enablement": "makefileTasks.hasCompletedExecutions"
      },
      {
        "command": "makefileTasks.toggleSelectionMode",
        "title": "Toggle Multi-select Mode",
        "category": "Make Run Tasks",
        "icon": "$(checklist)"
      },
      {
        "command": "makefileTasks.runSelectedTargetsInSequence",
        "title": "Run in Sequence",
        "category": "Make Run Tasks",
        "icon": "$(run-all)",
        "enablement": "makefileTasks.hasSelection"
      },
      {
        "command": "makefileTasks.clearSelection",
        "title": "Clear Selection",
        "category": "Make Run Tasks",
        "icon": "$(clear-all)",
        "enablement": "makefileTasks.hasSelection"
      },
      {
        "command": "makefileTasks.refresh",
        "title": "Refresh Targets",
        "category": "Make Run Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "makefileTasks.runTarget",
        "title": "Run Target",
        "category": "Make Run Tasks",
        "icon": "$(play)"
      },
      {
        "command": "makefileTasks.runTargetWithArgs",
        "title": "Run Target with Arguments",
        "category": "Make Run Tasks",
        "icon": "$(run-all)"
      },
      {
        "command": "makefileTasks.runTargetPicker",
        "title": "Run Target…",
        "category": "Make Run Tasks",
        "icon": "$(list-selection)"
      },
      {
        "command": "makefileTasks.openTarget",
        "title": "Go to Target Definition",
        "category": "Make Run Tasks",
        "icon": "$(go-to-file)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "makefileTasks",
          "title": "Make Run Tasks",
          "icon": "assets/makefile.svg"
        }
      ]
    },
    "views": {
      "makefileTasks": [
        {
          "id": "makefileTasks.targets",
          "name": "Targets",
          "icon": "assets/makefile.svg",
          "contextualTitle": "Make Run Tasks"
        },
        {
          "id": "makefileTasks.execution",
          "name": "Execution",
          "contextualTitle": "Make Run Tasks",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "makefileTasks.execution",
        "contents": "Run a target or select multiple targets to see their execution status here."
      },
      {
        "view": "makefileTasks.targets",
        "contents": "No documented Makefile targets were found. Add a `##` description immediately before a target, or use `target: ## description`.\n[Refresh](command:makefileTasks.refresh)",
        "when": "!makefileTasks.hasTargets"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "makefileTasks.resumeExecution",
          "when": "false"
        },
        {
          "command": "makefileTasks.rerunExecution",
          "when": "false"
        },
        {
          "command": "makefileTasks.deleteExecution",
          "when": "false"
        },
        {
          "command": "makefileTasks.copyExecutionCommands",
          "when": "false"
        },
        {
          "command": "makefileTasks.showExecutionCommands",
          "when": "false"
        },
        {
          "command": "makefileTasks.openExecutionTarget",
          "when": "false"
        },
        {
          "command": "makefileTasks.cancelExecution",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "makefileTasks.clearExecutionHistory",
          "when": "view == makefileTasks.execution",
          "group": "navigation@1"
        },
        {
          "command": "makefileTasks.toggleSelectionMode",
          "when": "view == makefileTasks.targets && (makefileTasks.hasTargets || makefileTasks.selectionMode)",
          "group": "navigation@1"
        },
        {
          "command": "makefileTasks.runSelectedTargetsInSequence",
          "when": "view == makefileTasks.targets && makefileTasks.selectionMode",
          "group": "navigation@2"
        },
        {
          "command": "makefileTasks.clearSelection",
          "when": "view == makefileTasks.targets && makefileTasks.selectionMode",
          "group": "navigation@3"
        },
        {
          "command": "makefileTasks.refresh",
          "when": "view == makefileTasks.targets",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "makefileTasks.resumeExecution",
          "when": "view == makefileTasks.execution && viewItem == executionCompletedResumable",
          "group": "inline@1"
        },
        {
          "command": "makefileTasks.rerunExecution",
          "when": "view == makefileTasks.execution && viewItem =~ /^executionCompleted/",
          "group": "inline@2"
        },
        {
          "command": "makefileTasks.deleteExecution",
          "when": "view == makefileTasks.execution && viewItem =~ /^executionCompleted/",
          "group": "inline@3"
        },
        {
          "command": "makefileTasks.openExecutionTarget",
          "when": "view == makefileTasks.execution && viewItem == executionStep",
          "group": "inline@1"
        },
        {
          "command": "makefileTasks.resumeExecution",
          "when": "view == makefileTasks.execution && viewItem == executionCompletedResumable",
          "group": "run@1"
        },
        {
          "command": "makefileTasks.rerunExecution",
          "when": "view == makefileTasks.execution && viewItem =~ /^executionCompleted/",
          "group": "run@2"
        },
        {
          "command": "makefileTasks.deleteExecution",
          "when": "view == makefileTasks.execution && viewItem =~ /^executionCompleted/",
          "group": "run@3"
        },
        {
          "command": "makefileTasks.cancelExecution",
          "when": "view == makefileTasks.execution && viewItem == executionActive",
          "group": "run@1"
        },
        {
          "command": "makefileTasks.openExecutionTarget",
          "when": "view == makefileTasks.execution && viewItem =~ /^execution/",
          "group": "navigation@1"
        },
        {
          "command": "makefileTasks.showExecutionCommands",
          "when": "view == makefileTasks.execution && viewItem =~ /^execution/",
          "group": "inspect@1"
        },
        {
          "command": "makefileTasks.copyExecutionCommands",
          "when": "view == makefileTasks.execution && viewItem =~ /^execution/",
          "group": "inspect@2"
        },
        {
          "command": "makefileTasks.cancelExecution",
          "when": "view == makefileTasks.execution && viewItem == executionActive",
          "group": "inline@1"
        },
        {
          "command": "makefileTasks.runTargetWithArgs",
          "when": "view == makefileTasks.targets && viewItem == makefileTarget && !makefileTasks.selectionMode",
          "group": "inline@1"
        },
        {
          "command": "makefileTasks.openTarget",
          "when": "view == makefileTasks.targets && viewItem == makefileTarget",
          "group": "inline@2"
        },
        {
          "command": "makefileTasks.openTarget",
          "when": "view == makefileTasks.targets && viewItem == makefileTarget",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Make Run Tasks",
      "properties": {
        "makefileTasks.makeCommand": {
          "type": "string",
          "default": "make",
          "description": "Make executable or command available to the extension host."
        },
        "makefileTasks.fileGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/Makefile",
            "**/makefile",
            "**/GNUmakefile"
          ],
          "description": "Workspace-relative glob patterns used to discover Makefiles."
        },
        "makefileTasks.excludeGlob": {
          "type": "string",
          "default": "**/{.git,node_modules,vendor,.venv,dist,out}/**",
          "description": "Glob pattern excluded from Makefile discovery."
        },
        "makefileTasks.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Refresh documented targets after matching Makefiles change."
        },
        "makefileTasks.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Run and Run with Arguments links above documented targets in workspace Makefile editors. Also requires editor.codeLens to be enabled."
        },
        "makefileTasks.sort": {
          "type": "string",
          "enum": [
            "source",
            "name"
          ],
          "enumDescriptions": [
            "Preserve target order from each Makefile.",
            "Sort targets alphabetically."
          ],
          "default": "source",
          "description": "Target ordering in the explorer and task picker."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "makefileTarget",
        "required": [
          "target"
        ],
        "properties": {
          "executionId": {
            "type": "string",
            "description": "Internal identifier for an extension-managed execution."
          },
          "target": {
            "type": "string",
            "description": "Make target to execute."
          },
          "makefile": {
            "type": "string",
            "description": "Optional workspace-relative Makefile path used to disambiguate the target."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional arguments or variable assignments passed to make."
          }
        },
        "when": "shellExecutionSupported"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run check && npm run build",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude \"test/integration/**\" --exclude \".integration-test/**\" --exclude \".vscode-test/**\"",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run build && npm run compile:integration && node .integration-test/test/integration/runTest.js",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "mcp:start": "npm run build && node dist/mcp/index.mjs",
    "mcp:inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/mcp/index.mjs",
    "watch": "tsc -p tsconfig.build.json --watch",
    "prepackage": "node -e \"require('node:fs').mkdirSync('out', { recursive: true })\"",
    "package": "vsce package --no-dependencies --out out/",
    "marketplace:login": "vsce login ai-follwer",
    "marketplace:preview": "node scripts/publish-marketplace.mjs --dry-run",
    "marketplace:publish": "node scripts/publish-marketplace.mjs",
    "marketplace:release": "npm version patch --no-git-tag-version && npm run marketplace:publish"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.1",
    "@types/vscode": "1.134.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "eslint": "10.12.0",
    "mocha": "12.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "extensionKind": [
    "workspace"
  ]
}
